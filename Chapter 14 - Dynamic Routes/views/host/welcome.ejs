<%- include('../partials/head', { pageTitle: 'Airbnb - Welcome' }) %>
<%- include('../partials/nav', { currentPage: 'host' }) %>

  <!-- Welcome / Confirmation Content -->
  <main class="flex-1 flex items-center justify-center p-6">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-gray-200/80 p-8 sm:p-10 text-center">
      <div class="w-14 h-14 bg-green-50 text-green-600 rounded-full flex items-center justify-center mx-auto mb-5 border border-green-100 shadow-xs">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h1 class="text-2xl font-extrabold text-gray-900 mb-2 tracking-tight">Registration Successful!</h1>
      <p class="text-sm text-gray-500 mb-6">Your home listing has been saved and is now ready for guests.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href="/host/home-registration" class="w-full sm:w-auto py-2.5 px-4 bg-white hover:bg-gray-50 text-gray-700 font-semibold border border-gray-300 rounded-xl text-sm shadow-xs hover:shadow transition-all">
          Add Another Home
        </a>
        <a href="/host/dashboard" class="w-full sm:w-auto py-2.5 px-5 bg-rose-500 hover:bg-rose-600 text-white font-semibold rounded-xl text-sm shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all">
          Go to Host Desk
        </a>
      </div>
    </div>
  </main>

<%- include('../partials/footer') %>
