<%- include('../partials/head', { pageTitle: 'Airbnb - ' + home.homeName }) %>
<%- include('../partials/nav', { currentPage: 'home' }) %>

  <!-- Home Details Page -->
  <main class="flex-1 max-w-6xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8">
    <!-- Top Bar -->
    <div class="mb-6">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-gray-600 hover:text-gray-900 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back
      </a>
    </div>

    <!-- Two-Column Details Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Property Details -->
      <section class="lg:col-span-7 bg-white rounded-2xl border border-gray-200/80 shadow-md p-6 sm:p-8">
        <h1 class="text-lg sm:text-xl font-bold text-gray-900 pb-4 border-b border-gray-200">Property Details</h1>
        <dl class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-6 text-sm">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Home Name</dt>
            <dd class="mt-1 font-bold text-gray-900 text-base"><%= home.homeName %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Location</dt>
            <dd class="mt-1 font-bold text-gray-900 text-base"><%= home.location %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Rating</dt>
            <dd class="mt-1 font-bold text-gray-900 text-base"><span class="text-rose-500">★</span> <%= home.rating %></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-500">Home ID</dt>
            <dd class="mt-1 font-bold text-gray-900 text-base">#<%= home.id %></dd>
          </div>
        </dl>
      </section>

      <!-- Right Column: Compact Photo + Price & Book -->
      <aside class="lg:col-span-5 bg-white rounded-2xl border border-gray-200/80 shadow-xl ring-1 ring-black/5 overflow-clip">
        <!-- Photo Preview (Click to enlarge) -->
        <div class="relative aspect-[4/3] w-full overflow-clip bg-gray-100 group">
          <button
            type="button"
            onclick="openImageModal()"
            class="block w-full h-full cursor-zoom-in focus:outline-none"
            aria-label="View larger photo of <%= home.homeName %>"
          >
            <img
              src="<%= home.photoUrl %>"
              alt="<%= home.homeName %>"
              fetchpriority="high"
              class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
              onerror="this.src='https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=1200&q=80'"
            >
            <span class="absolute bottom-3 right-3 px-2.5 py-1 rounded-lg bg-black/55 text-white text-xs font-medium backdrop-blur-xs opacity-90 group-hover:opacity-100 transition">
              Click to enlarge
            </span>
          </button>

          <!-- Favourite Toggle Button -->
          <button
            type="button"
            onclick="toggleFavorite(this)"
            class="absolute top-3 right-3 z-10 p-1.5 rounded-full hover:scale-110 active:scale-90 transition-transform cursor-pointer focus:outline-none"
            aria-label="Toggle favourite"
          >
            <svg class="w-6 h-6 stroke-white stroke-2 fill-black/35 drop-shadow transition-colors duration-200" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </button>
        </div>

        <!-- Price & Book Row -->
        <div class="p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4 border-t border-gray-100">
          <div class="flex items-baseline gap-1.5 min-w-0">
            <span class="text-2xl font-extrabold text-gray-900">৳ <%= home.price %></span>
            <span class="text-sm text-gray-500 font-medium">/ night</span>
          </div>

          <button
            type="button"
            class="px-7 py-3 bg-rose-500 hover:bg-rose-600 text-white font-semibold rounded-xl text-sm shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer shrink-0"
          >
            Book
          </button>
        </div>
      </aside>
    </div>
  </main>

  <!-- Large Image Modal (No extra route needed) -->
  <dialog
    id="imagePreviewDialog"
    closedby="any"
    aria-label="Large view of <%= home.homeName %>"
    class="m-auto p-0 bg-transparent border-0 max-w-5xl w-[92vw] max-h-[90vh] overflow-visible backdrop:bg-black/80 backdrop:backdrop-blur-xs focus:outline-none"
  >
    <div class="relative rounded-2xl overflow-clip bg-black shadow-2xl border border-white/15">
      <form method="dialog">
        <button
          type="submit"
          aria-label="Close large image"
          class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-black/60 hover:bg-black/80 text-white flex items-center justify-center transition cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </form>
      <img
        src="<%= home.photoUrl %>"
        alt="<%= home.homeName %>"
        class="w-full max-h-[85vh] object-contain mx-auto"
        onerror="this.src='https://images.unsplash.com/photo-1580587771525-78b9dba3b914?auto=format&fit=crop&w=1200&q=80'"
      >
    </div>
  </dialog>

  <script>
    function toggleFavorite(btn) {
      const svg = btn.querySelector('svg');
      svg.classList.toggle('fill-rose-500');
      svg.classList.toggle('stroke-rose-500');
      svg.classList.toggle('fill-black/35');
      svg.classList.toggle('stroke-white');
    }

    const imageDialog = document.getElementById('imagePreviewDialog');

    function openImageModal() {
      imageDialog.showModal();
    }

    // Light-dismiss fallback for browsers without closedby="any" support (e.g., Safari)
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      imageDialog.addEventListener('click', (event) => {
        if (event.target !== imageDialog) return;
        const rect = imageDialog.getBoundingClientRect();
        const isDialogContent = (
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width
        );
        if (!isDialogContent) {
          imageDialog.close();
        }
      });
    }
  </script>

<%- include('../partials/footer') %>
