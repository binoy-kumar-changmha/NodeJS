<%- include('../partials/head', { pageTitle: 'Airbnb - Home Registration' }) %>
<%- include('../partials/nav', { currentPage: 'host' }) %>

  <!-- Form Content -->
  <main class="flex-1 flex items-center justify-center p-6">
    <div class="w-full max-w-lg bg-white rounded-2xl shadow-xl border border-gray-200/80 p-8 sm:p-10">
      <h1 class="text-2xl text-center font-extrabold text-gray-900 mb-6 tracking-tight">Home Registration</h1>
      <form action="/host/welcome-msg" method="POST" class="space-y-4">
        <!-- Home Name -->
        <div>
          <input 
            type="text" 
            id="homeName" 
            name="homeName" 
            placeholder="House name" 
            required 
            class="w-full px-3.5 py-2.5 bg-gray-50/60 focus:bg-white border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 shadow-xs transition-all"
          >
        </div>

        <!-- Price & Rating Row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <input 
              type="number" 
              id="price" 
              name="price" 
              placeholder="Price per night" 
              required 
              min="0"
              class="w-full px-3.5 py-2.5 bg-gray-50/60 focus:bg-white border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 shadow-xs transition-all"
            >
          </div>
          <div>
            <input 
              type="number" 
              id="rating" 
              name="rating" 
              step="0.1" 
              min="1" 
              max="5" 
              placeholder="Rating" 
              required 
              class="w-full px-3.5 py-2.5 bg-gray-50/60 focus:bg-white border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 shadow-xs transition-all"
            >
          </div>
        </div>

        <!-- Location -->
        <div>
          <input 
            type="text" 
            id="location" 
            name="location" 
            placeholder="Location" 
            required 
            class="w-full px-3.5 py-2.5 bg-gray-50/60 focus:bg-white border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 shadow-xs transition-all"
          >
        </div>

        <!-- Photo URL -->
        <div>
          <input 
            type="url" 
            id="photoUrl" 
            name="photoUrl" 
            placeholder="Photo URL" 
            class="w-full px-3.5 py-2.5 bg-gray-50/60 focus:bg-white border border-gray-300 rounded-xl text-sm focus:outline-none focus:ring-4 focus:ring-rose-500/10 focus:border-rose-500 shadow-xs transition-all"
          >
        </div>

        <button 
          type="submit" 
          class="w-full py-3 px-4 bg-rose-500 hover:bg-rose-600 text-white font-semibold rounded-xl transition-all cursor-pointer text-sm shadow-md hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0"
        >
          Submit Listing
        </button>
      </form>
    </div>
  </main>

<%- include('../partials/footer') %>
