      <nav class="flex items-center space-x-2 sm:space-x-4">
        <a href="/" class="hover:bg-rose-600 px-3 py-1.5 rounded-lg text-sm sm:text-base font-medium transition">Go to Home</a>
        <a href="/user/home-registration" class="hover:bg-rose-600 px-3 py-1.5 rounded-lg text-sm sm:text-base font-medium transition">Add Home</a>
        <a href="/host/admin" class="bg-rose-600 font-semibold px-3 py-1.5 rounded-lg text-sm sm:text-base transition">Admin Panel</a>
      </nav>
    </div>
  </header>

  <!-- Admin Panel Content -->
  <main class="flex-1 flex items-center justify-center p-6">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-sm border border-gray-100 p-8 text-center">
      <h1 class="text-2xl font-bold text-rose-500 mb-2">Admin Panel</h1>
      <br>
      <p class="text-gray-600 text-sm mb-6">Welcome to the <strong>Admin Dashboard</strong>.</p>
    </div>
